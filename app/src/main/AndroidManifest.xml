<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to enumerate every installed app for the home-screen grid + icon-pack matching.
         Google Play grants an explicit policy exception for this permission to default
         launcher apps, so it's expected/required here. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- System Status widget: Wi-Fi connectivity state. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Home header's Weather row (WeatherHelper.kt): a coarse fix is all that's needed for a
         temperature reading, and INTERNET is required to reach Open-Meteo - the only network
         call anywhere in Zenith. Declining the runtime prompt just leaves the row showing "—°". -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Syncing the chosen background photo to the actual Home/Lock screen wallpaper. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- System Status widget: name of a connected Bluetooth device (and its battery level, best
         effort - there's no public API for that, see SystemStatusWidget.kt). BLUETOOTH_CONNECT
         is the runtime permission on API 31+; plain BLUETOOTH covers older versions. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".ZenithApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_zenith"
        android:roundIcon="@mipmap/ic_zenith_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ZenithStudyHelper"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.ZenithStudyHelper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".util.StudyTimerReceiver" android:exported="false" />

        <!-- See ZenithDeviceAdminReceiver: exists only for the double-tap-to-lock gesture. -->
        <receiver
            android:name=".service.ZenithDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
